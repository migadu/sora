#!/bin/sh

# Sora Mail Server — FreeBSD rc.d service script
# Install: cp dist/sora.rc /usr/local/etc/rc.d/sora && chmod +x /usr/local/etc/rc.d/sora
# Enable:  sysrc sora_enable=YES
# Start:   service sora start
# Reload:  service sora reload  (sends SIGHUP for config reload)
# Logs:    tail -f /var/log/sora/sora.log  ([logging] output = "/var/log/sora/sora.log";
#          with the default output, stderr, they go to /var/log/sora/sora.out)

# PROVIDE: sora
# REQUIRE: LOGIN networking postgresql
# KEYWORD: shutdown

. /etc/rc.subr

name="sora"
rcvar="sora_enable"

load_rc_config $name

: ${sora_enable:="NO"}
: ${sora_user:="sora"}
: ${sora_group:="sora"}
: ${sora_config:="/usr/local/etc/sora/config.toml"}
: ${sora_logdir:="/var/log/sora"}
: ${sora_spooldir:="/var/spool/sora"}

# sora stays in the foreground and writes no pidfile. daemon(8) detaches it, writes its
# PID to ${pidfile} (which status, stop and reload use; procname matches it), sends its
# output to sora.out and runs it as ${sora_user}.
pidfile="/var/run/${name}.pid"
procname="/usr/local/bin/sora"
command="/usr/sbin/daemon"
command_args="-f -p ${pidfile} -u ${sora_user} -o ${sora_logdir}/sora.out ${procname} --config ${sora_config}"

# SIGHUP triggers config reload. rc.subr provides reload only when extra_commands lists it.
extra_commands="reload"
sig_reload="HUP"

start_precmd="sora_precmd"

sora_precmd()
{
    # Ensure required directories exist
    install -d -o ${sora_runas} -g ${sora_group} -m 750 ${sora_logdir}
    install -d -o ${sora_runas} -g ${sora_group} -m 750 ${sora_spooldir}
}

# daemon(8) changes to sora_user itself (-u), and must start as root to write ${pidfile}.
# With sora_user set, rc.subr would start it through su(1) as that user instead.
sora_runas=${sora_user}
unset sora_user

run_rc_command "$1"
