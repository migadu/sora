# Sora Mail Server — systemd service file
# Install: cp dist/sora.service /etc/systemd/system/sora.service
#          install -d -o sora -g sora -m 0750 /var/spool/sora
# Enable:  systemctl daemon-reload && systemctl enable sora
# Start:   systemctl start sora
# Reload:  systemctl reload sora  (sends SIGHUP for config reload)
# Logs:    journalctl -u sora -f

[Unit]
Description=Sora Mail Server
Documentation=https://github.com/migadu/sora
# PostgreSQL is wanted, not required: a proxy node or a backend with a remote database
# has no local postgresql.service (a missing Wants= unit is ignored), and stopping or
# restarting the database does not stop sora. After= orders the start when both run here.
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=sora
Group=sora

ExecStart=/usr/local/bin/sora --config /etc/sora/config.toml
ExecReload=/bin/kill -HUP $MAINPID

# Graceful shutdown: on SIGTERM sora waits up to 10s for its listeners to close, 3s for
# sessions to release database resources, then stops its workers (in-flight S3 uploads
# finish) and leaves the cluster (up to 5s). After TimeoutStopSec the rest is killed.
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

# Restart on failure with backoff
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The private /tmp is deleted whenever the service stops: nothing sora must keep may live
# there. Writable and kept across restarts (the defaults point here):
#   /var/spool/sora   [uploader] path (staged bodies, the only copy until uploaded),
#                     [relay.queue] path; create it at install (see above)
#   /var/lib/sora     TLS fallback_dir (StateDirectory)
#   /var/cache/sora   [local_cache] path, [auth_cache] path (CacheDirectory)
#   /var/log/sora     [logging] output, when a file (LogsDirectory)
PrivateTmp=true
StateDirectory=sora
CacheDirectory=sora
LogsDirectory=sora
ReadWritePaths=/var/spool/sora

# File descriptor limits (for many concurrent connections)
LimitNOFILE=65536

# Allow binding to privileged ports (143, 993, 110, 995, etc.)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
